use log::{info, error, debug};
use std::cmp::min;
use std::time::{Instant, Duration};
use tokio::time::sleep;
use reqwest::{Client, Body};
use futures::stream::{self, StreamExt};
use bytes::Bytes;
use rand::{thread_rng, Rng, distributions::Alphanumeric};
use clap::Parser;
use std::fmt;

const CHUNK_SIZE: usize = 64 * 1024; // 64KB
const NETWORK_DELAY_MS: u64 = 50; // Base simulated network delay in milliseconds
const RETRY_ATTEMPTS: usize = 3; // Number of retry attempts for failed requests
const REQUEST_TIMEOUT: u64 = 30; // Timeout in seconds for HTTP requests

/// Command line arguments for the speed test
#[derive(Parser, Debug)]
#[clap(
    name = "rusty-speedtest",
    about = "A network speed test tool written in Rust",
    version = "1.0.0"
)]
struct Args {
    /// Server URL to test against
    #[clap(short, long, default_value = "https://speed.cloudflare.com/__down")]
    server: String,

    /// Optional separate upload server URL
    #[clap(short, long)]
    upload_server: Option<String>,

    /// Size of download test in MB
    #[clap(short, long, default_value = "10")]
    download_size: usize,

    /// Size of upload test in MB
    #[clap(short, long, default_value = "5")]
    upload_size: usize,

    /// Skip ping test
    #[clap(long)]
    skip_ping: bool,

    /// Skip download test
    #[clap(long)]
    skip_download: bool,

    /// Skip upload test
    #[clap(long)]
    skip_upload: bool,

    /// Output format (simple, json, csv)
    #[clap(short, long, default_value = "simple")]
    format: String,

    /// Run tests sequentially instead of concurrently
    #[clap(long)]
    sequential: bool,
}

/// Custom error type for structured error handling
#[derive(Debug)]
enum SpeedTestError {
    InvalidUrl(String),
    RequestFailed(String),
    NoDataDownloaded,
    NoSuccessfulMeasurements,
    Timeout,
    Other(String),
}

impl fmt::Display for SpeedTestError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            SpeedTestError::InvalidUrl(url) => write!(f, "Invalid URL: {}", url),
            SpeedTestError::RequestFailed(err) => write!(f, "Request failed: {}", err),
            SpeedTestError::NoDataDownloaded => write!(f, "No data was downloaded"),
            SpeedTestError::NoSuccessfulMeasurements => write!(f, "No successful measurements were made"),
            SpeedTestError::Timeout => write!(f, "Request timed out"),
            SpeedTestError::Other(msg) => write!(f, "Error: {}", msg),
        }
    }
}

/// Result of a network measurement (ping, download, or upload)
#[derive(Debug)]
struct MeasurementResult {
    speed: f64,
    jitter: f64,
    error: Option<String>,
}

impl MeasurementResult {
    /// Create a new measurement result with speed and jitter
    fn new(speed: f64, jitter: f64) -> Self {
        Self {
            speed,
            jitter,
            error: None,
        }
    }

    /// Create a measurement result with an error
    fn with_error(error: SpeedTestError) -> Self {
        Self {
            speed: 0.0,
            jitter: 0.0,
            error: Some(format!("{}", error)),
        }
    }
}

/// Reusable function to calculate jitter from a series of measurements
fn calculate_jitter(values: &[f64]) -> f64 {
    if values.len() <= 1 {
        return 0.0;
    }
    let mut diff_sum = 0.0;
    for i in 1..values.len() {
        diff_sum += (values[i] - values[i - 1]).abs();
    }
    diff_sum / (values.len() - 1) as f64
}

/// Simulate upload for when the server doesn't accept uploads
///
/// This function simulates sending data with realistic network conditions
/// by introducing random delay variations to better represent real-world scenarios.
async fn simulate_upload(data_size: usize) -> f64 {
    let start = Instant::now();
    let mut sent = 0;
    let mut rng = thread_rng();

    while sent < data_size {
        let to_send = min(CHUNK_SIZE, data_size - sent);
        
        // Vary the delay between 30-70ms to simulate network jitter
        let delay = NETWORK_DELAY_MS + rng.gen_range(-20..20);
        sleep(Duration::from_millis(delay.max(10))).await;
        
        sent += to_send;
    }

    let duration = start.elapsed();
    (data_size as f64 * 8.0) / (1000.0 * 1000.0) / duration.as_secs_f64()
}

/// Test ping to the server
///
/// Measures the round-trip time to the server by sending small HTTP HEAD requests
async fn test_ping(args: &Args) -> MeasurementResult {
    info!("Starting ping test to {}", args.server);
    let client = Client::builder()
        .timeout(Duration::from_secs(5))
        .build()
        .unwrap_or_default();
    
    let mut ping_measurements = Vec::new();
    
    for i in 0..5 {
        debug!("Ping measurement {}/5", i+1);
        let start = Instant::now();
        let result = client.head(&args.server).send().await;
        
        match result {
            Ok(_) => {
                let duration = start.elapsed();
                let ping_ms = duration.as_secs_f64() * 1000.0;
                ping_measurements.push(ping_ms);
                debug!("Ping measurement {}: {:.2} ms", i+1, ping_ms);
            }
            Err(e) => {
                error!("Ping measurement {} failed: {}", i+1, e);
                // Continue with other measurements
            }
        }
        
        sleep(Duration::from_millis(100)).await;
    }
    
    if ping_measurements.is_empty() {
        return MeasurementResult::with_error(SpeedTestError::NoSuccessfulMeasurements);
    }
    
    let avg_ping = ping_measurements.iter().sum::<f64>() / ping_measurements.len() as f64;
    let jitter = calculate_jitter(&ping_measurements);
    
    info!("Ping test completed: {:.2} ms avg, {:.2} ms jitter", avg_ping, jitter);
    MeasurementResult::new(avg_ping, jitter)
}

/// Test download speed with retry logic and timeouts
///
/// Downloads data from the server in chunks and measures the download speed
async fn test_download(args: &Args, client: &Client) -> MeasurementResult {
    info!("Starting download test from {}", args.server);
    let mut speed_measurements = Vec::new();
    let chunk_size = (args.download_size * 1024 * 1024) / 5;

    for i in 0..5 {
        debug!("Download measurement {}/5", i+1);
        let start = Instant::now();
        
        // Try with retries
        let mut response = None;
        for attempt in 0..RETRY_ATTEMPTS {
            match client.get(&args.server).send().await {
                Ok(resp) => {
                    response = Some(resp);
                    break;
                }
                Err(e) => {
                    if attempt < RETRY_ATTEMPTS - 1 {
                        let backoff = Duration::from_millis(100 * 2_u64.pow(attempt as u32));
                        error!("Download attempt {} failed: {}. Retrying in {:?}...", 
                               attempt + 1, e, backoff);
                        sleep(backoff).await;
                    } else {
                        error!("All download attempts failed: {}", e);
                        return MeasurementResult::with_error(
                            SpeedTestError::RequestFailed(e.to_string()));
                    }
                }
            }
        }
        
        let mut response = match response {
            Some(r) => r,
            None => return MeasurementResult::with_error(
                SpeedTestError::RequestFailed("All attempts failed".to_string())),
        };

        let mut downloaded = 0;
        while let Some(chunk_result) = response.chunk().await {
            match chunk_result {
                Ok(chunk) => {
                    downloaded += chunk.len();
                    if downloaded >= chunk_size {
                        break;
                    }
                }
                Err(e) => {
                    error!("Error downloading chunk: {}", e);
                    break;
                }
            }
        }

        if downloaded == 0 {
            error!("No data downloaded in measurement {}", i+1);
            continue;
        }

        let duration = start.elapsed();
        let speed_mbps = (downloaded as f64 * 8.0) / (1000.0 * 1000.0) / duration.as_secs_f64();
        speed_measurements.push(speed_mbps);
        debug!("Download measurement {}: {:.2} Mbps", i+1, speed_mbps);

        sleep(Duration::from_millis(100)).await;
    }

    if speed_measurements.is_empty() {
        return MeasurementResult::with_error(SpeedTestError::NoSuccessfulMeasurements);
    }

    let avg_speed = speed_measurements.iter().sum::<f64>() / speed_measurements.len() as f64;
    let jitter = calculate_jitter(&speed_measurements);

    info!("Download test completed: {:.2} Mbps avg, {:.2} Mbps jitter", avg_speed, jitter);
    MeasurementResult::new(avg_speed, jitter)
}

/// Test upload speed with streaming to avoid memory issues
///
/// Uploads data to the server in chunks and measures the upload speed
async fn test_upload(args: &Args, client: &Client) -> MeasurementResult {
    let upload_url = args.upload_server.as_deref().unwrap_or(&args.server);
    info!("Starting upload test to {}", upload_url);
    
    let data_size = args.upload_size * 1024 * 1024 / 5;
    let mut speed_measurements = Vec::new();

    for i in 0..5 {
        debug!("Upload measurement {}/5", i+1);
        let start = Instant::now();

        // Create a stream of random chunks instead of one large allocation
        let stream = stream::iter(0..5)
            .map(|_| {
                // Divide the upload into smaller chunks to avoid large memory allocations
                let chunk_size = data_size / 5;
                let random_data = Alphanumeric
                    .sample_string(&mut thread_rng(), min(chunk_size, 1024 * 1024));
                Ok::<_, reqwest::Error>(Bytes::from(random_data))
            });

        let body = Body::wrap_stream(stream);
        
        // Try with retries
        let mut upload_success = false;
        for attempt in 0..RETRY_ATTEMPTS {
            match client.post(upload_url).body(body.clone()).send().await {
                Ok(_) => {
                    upload_success = true;
                    break;
                }
                Err(e) => {
                    if attempt < RETRY_ATTEMPTS - 1 {
                        let backoff = Duration::from_millis(100 * 2_u64.pow(attempt as u32));
                        error!("Upload attempt {} failed: {}. Retrying in {:?}...", 
                               attempt + 1, e, backoff);
                        sleep(backoff).await;
                    } else {
                        error!("All upload attempts failed: {}. Using simulated data.", e);
                        // Fall back to simulation
                        let simulated_speed = simulate_upload(data_size).await;
                        speed_measurements.push(simulated_speed);
                        debug!("Simulated upload measurement {}: {:.2} Mbps", i+1, simulated_speed);
                    }
                }
            }
        }

        if upload_success {
            let duration = start.elapsed();
            let speed_mbps = (data_size as f64 * 8.0) / (1000.0 * 1000.0) / duration.as_secs_f64();
            speed_measurements.push(speed_mbps);
            debug!("Upload measurement {}: {:.2} Mbps", i+1, speed_mbps);
        }

        sleep(Duration::from_millis(100)).await;
    }

    if speed_measurements.is_empty() {
        return MeasurementResult::with_error(SpeedTestError::NoSuccessfulMeasurements);
    }

    let avg_speed = speed_measurements.iter().sum::<f64>() / speed_measurements.len() as f64;
    let jitter = calculate_jitter(&speed_measurements);

    info!("Upload test completed: {:.2} Mbps avg, {:.2} Mbps jitter", avg_speed, jitter);
    MeasurementResult::new(avg_speed, jitter)
}

/// Format the results as JSON
fn format_json_output(ping: &MeasurementResult, download: &MeasurementResult, upload: &MeasurementResult) -> String {
    serde_json::json!({
        "ping": {
            "value": ping.speed,
            "jitter": ping.jitter,
            "error": ping.error
        },
        "download": {
            "value": download.speed,
            "jitter": download.jitter,
            "error": download.error
        },
        "upload": {
            "value": upload.speed,
            "jitter": upload.jitter,
            "error": upload.error
        }
    }).to_string()
}

/// Format the results as CSV
fn format_csv_output(ping: &MeasurementResult, download: &MeasurementResult, upload: &MeasurementResult) -> String {
    format!(
        "test,value,jitter,error\nping,{:.2},{:.2},{}\ndownload,{:.2},{:.2},{}\nupload,{:.2},{:.2},{}\n",
        ping.speed, 
        ping.jitter, 
        ping.error.as_deref().unwrap_or(""), 
        download.speed, 
        download.jitter, 
        download.error.as_deref().unwrap_or(""),
        upload.speed, 
        upload.jitter, 
        upload.error.as_deref().unwrap_or("")
    )
}

/// Format the results in a simple text format
fn format_simple_output(ping: &MeasurementResult, download: &MeasurementResult, upload: &MeasurementResult) -> String {
    let mut output = String::new();
    
    if ping.error.is_none() {
        output.push_str(&format!("Ping: {:.2} ms (Jitter: {:.2} ms)\n", ping.speed, ping.jitter));
    } else {
        output.push_str(&format!("Ping: Failed - {}\n", ping.error.as_deref().unwrap_or("Unknown error")));
    }
    
    if download.error.is_none() {
        output.push_str(&format!("Download: {:.2} Mbps (Jitter: {:.2} Mbps)\n", download.speed, download.jitter));
    } else {
        output.push_str(&format!("Download: Failed - {}\n", download.error.as_deref().unwrap_or("Unknown error")));
    }
    
    if upload.error.is_none() {
        output.push_str(&format!("Upload: {:.2} Mbps (Jitter: {:.2} Mbps)\n", upload.speed, upload.jitter));
    } else {
        output.push_str(&format!("Upload: Failed - {}\n", upload.error.as_deref().unwrap_or("Unknown error")));
    }
    
    output
}

/// Main function
#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Initialize logging based on environment variable
    env_logger::init();
    info!("Starting network speed test");
    
    // Parse command line arguments
    let args = Args::parse();
    
    // Validate inputs early
    if !args.server.starts_with("http") {
        error!("Server URL must start with http:// or https://");
        return Err(Box::new(SpeedTestError::InvalidUrl(args.server)));
    }
    
    if let Some(ref upload_url) = args.upload_server {
        if !upload_url.starts_with("http") {
            error!("Upload server URL must start with http:// or https://");
            return Err(Box::new(SpeedTestError::InvalidUrl(upload_url.clone())));
        }
    }
    
    // Create HTTP client with timeout
    let client = Client::builder()
        .timeout(Duration::from_secs(REQUEST_TIMEOUT))
        .build()?;
    
    let (ping_result, download_result, upload_result) = if args.sequential {
        // Run tests sequentially
        info!("Running tests sequentially");
        let ping_result = if !args.skip_ping { 
            test_ping(&args).await 
        } else { 
            info!("Skipping ping test");
            MeasurementResult::new(0.0, 0.0) 
        };
        
        let download_result = if !args.skip_download { 
            test_download(&args, &client).await 
        } else { 
            info!("Skipping download test");
            MeasurementResult::new(0.0, 0.0) 
        };
        
        let upload_result = if !args.skip_upload { 
            test_upload(&args, &client).await 
        } else { 
            info!("Skipping upload test");
            MeasurementResult::new(0.0, 0.0) 
        };
        
        (ping_result, download_result, upload_result)
    } else {
        // Run tests concurrently
        info!("Running tests concurrently");
        tokio::join!(
            if !args.skip_ping { 
                test_ping(&args) 
            } else { 
                info!("Skipping ping test");
                async { MeasurementResult::new(0.0, 0.0) } 
            },
            if !args.skip_download { 
                test_download(&args, &client) 
            } else { 
                info!("Skipping download test");
                async { MeasurementResult::new(0.0, 0.0) } 
            },
            if !args.skip_upload { 
                test_upload(&args, &client) 
            } else { 
                info!("Skipping upload test");
                async { MeasurementResult::new(0.0, 0.0) } 
            },
        )
    };
    
    // Output results based on selected format
    match args.format.as_str() {
        "json" => {
            println!("{}", format_json_output(&ping_result, &download_result, &upload_result));
        }
        "csv" => {
            println!("{}", format_csv_output(&ping_result, &download_result, &upload_result));
        }
        _ => {
            println!("{}", format_simple_output(&ping_result, &download_result, &upload_result));
        }
    }
    
    info!("Speed test completed");
    Ok(())
}